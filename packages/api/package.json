{
  "name": "@vat-assist/api",
  "version": "0.1.0",
  "private": true,
  "description": "VAT Assist API — NestJS modular monolith over PostgreSQL with row-level security.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "migrate": "node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "seed": "node --env-file-if-exists=../../.env dist/scripts/seed.js",
    "demo": "node --env-file-if-exists=../../.env dist/scripts/demo.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-presigned-post": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@vat-assist/shared": "0.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "twilio": "^6.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
