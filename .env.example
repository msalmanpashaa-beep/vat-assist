# ---------- Core ----------
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000          # what Twilio/Stripe call back on (must be HTTPS in production)
WEB_BASE_URL=http://localhost:3000
TZ_BUSINESS=Indian/Mauritius

# Postgres: the API connects as the non-owner role vat_app so row-level security applies.
DATABASE_URL=postgres://vat_app:vat_app_dev@localhost:5432/vat_assist
# Migrations and seeds run as the schema owner.
DATABASE_OWNER_URL=postgres://vat_owner:vat_owner_dev@localhost:5432/vat_assist

# ---------- Security ----------
JWT_SECRET=change-me-to-64-random-bytes
DATA_ENCRYPTION_KEY=base64-32-bytes-here       # AES-256-GCM key for TOTP secrets: openssl rand -base64 32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---------- Owner sign-in (phone + SMS) ----------
OTP_PROVIDER=dev                               # dev | twilio-verify
OTP_DEV_FIXED_CODE=000000                      # dev only; the API refuses to start with this set in production
TWILIO_VERIFY_SERVICE_SID=

# ---------- Storage ----------
STORAGE_DRIVER=local                           # local | s3
STORAGE_LOCAL_DIR=./storage-dev
S3_BUCKET=vat-assist-documents
S3_REGION=af-south-1
S3_ENDPOINT=                                   # e.g. http://localhost:9000 for MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=15728640

# ---------- Document AI ----------
EXTRACTION_PROVIDER=mock                       # mock | anthropic
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5
AUTO_POST_THRESHOLD=0.85
REVIEW_THRESHOLD=0.75

# ---------- Jobs ----------
REDIS_URL=                                     # empty = run jobs inline (dev/demo); set for BullMQ in production

# ---------- Payments (Stripe Checkout) ----------
TRUST_PROXY_HOPS=1                             # proxies in front of the API; sets whose IP the rate limits see
PAYMENTS_MODE=mock                             # mock | live (live: MIPS and/or Stripe credentials below)
MIPS_API_URL=https://api.mips.mu/api
MIPS_ID_MERCHANT=
MIPS_ID_ENTITY=
MIPS_ID_OPERATOR=
MIPS_OPERATOR_PASSWORD=
MIPS_SALT=
MIPS_CIPHER_KEY=
MIPS_BASIC_AUTH_USER=
MIPS_BASIC_AUTH_PASS=
MIPS_IMN_FIELD=crypted_callback                # confirm the IMN field name with MIPS at onboarding
MIPS_IMN_PATH_SECRET=                          # optional: register /webhooks/mips/<secret> as the IMN URL
MIPS_TOUCHPOINT=web
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_dev_only_secret
DEPOSIT_DEFAULT_CENTS=2500                     # Rs 25.00 — see docs/DECISIONS.md before going live

# ---------- Messaging (Twilio SMS + WhatsApp) ----------
MESSAGING_PROVIDER=console                     # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                               # or a Messaging Service SID in TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=                          # e.g. whatsapp:+230xxxxxxxx
# JSON map template -> locale -> approved Content SID, e.g. {"vat_due_tomorrow":{"en":"HX..","fr":"HX.."}}
TWILIO_WHATSAPP_CONTENT_SIDS={}
REMINDER_SEND_HOUR_LOCAL=9

# --- Email (staff invites) ----------------------------------------------------
# console prints invites to the API log and GET /dev/mail/outbox; postmark, resend or m365 send them.
MAIL_PROVIDER=console
# Sender for Postmark and Resend: an address on a verified domain (or a Postmark sender signature).
MAIL_FROM=VAT Assist <invites@example.com>
MAIL_REPLY_TO=
# Postmark: server API token. POSTMARK_API_TEST is accepted by Postmark but nothing is delivered.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# Resend: API key with sending access (re_...).
RESEND_API_KEY=
# Microsoft 365 (Graph, app-only): Entra app registration + the mailbox the app may send as.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=
