# VAT Assist API: production settings. Every setting the API knows is listed here.
# Copy to .env.production on the API host (or into its secret manager). Never commit the filled-in file.
# Values in <angle brackets> are secrets or account details to fill. Empty means "not used".
# Check before deploying:  npm run config:check -- ../../.env.production   (from the repository root)

NODE_ENV=production
PORT=4000
PUBLIC_BASE_URL=https://api.nex-gen.africa
WEB_BASE_URL=https://app.nex-gen.africa
TZ_BUSINESS=Indian/Mauritius

# Database: the app connects as vat_app (no bypass of row-level security); migrations run as vat_owner.
DATABASE_URL=<postgres://vat_app:PASSWORD@HOST:5432/vat_assist?sslmode=require>
DATABASE_OWNER_URL=<postgres://vat_owner:PASSWORD@HOST:5432/vat_assist?sslmode=require>

# Generate once each: openssl rand -hex 48   /   openssl rand -base64 32. Keep DATA_ENCRYPTION_KEY forever (it opens stored authenticator secrets).
JWT_SECRET=<openssl rand -hex 48>
DATA_ENCRYPTION_KEY=<openssl rand -base64 32>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Owner sign-in codes by SMS (Twilio Verify).
OTP_PROVIDER=twilio-verify
OTP_DEV_FIXED_CODE=
TWILIO_VERIFY_SERVICE_SID=<VA...>

# Document storage: an S3 bucket that supports presigned POST uploads (AWS S3; af-south-1 is the closest region).
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=
S3_BUCKET=<vat-assist-documents>
S3_REGION=af-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=<access key id>
S3_SECRET_ACCESS_KEY=<secret access key>
MAX_UPLOAD_BYTES=15728640

# Reading invoices.
EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=<sk-ant-...>
EXTRACTION_MODEL=claude-sonnet-5-5
AUTO_POST_THRESHOLD=0.85
REVIEW_THRESHOLD=0.75

# Background jobs (document processing, reminders every 15 minutes).
REDIS_URL=<rediss://default:PASSWORD@HOST:6379>
TRUST_PROXY_HOPS=1

# Payments. Juice and bank transfers need no keys. Card keys stay empty until a merchant account exists.
PAYMENTS_MODE=live
DEPOSIT_DEFAULT_CENTS=2500
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MIPS_API_URL=https://api.mips.mu/api
MIPS_ID_MERCHANT=
MIPS_ID_ENTITY=
MIPS_ID_OPERATOR=
MIPS_OPERATOR_PASSWORD=
MIPS_SALT=
MIPS_CIPHER_KEY=
MIPS_BASIC_AUTH_USER=
MIPS_BASIC_AUTH_PASS=
MIPS_IMN_FIELD=crypted_callback
MIPS_IMN_PATH_SECRET=
MIPS_TOUCHPOINT=web

# Email (staff invites): Nex-Gen's cPanel mailbox for now.
MAIL_PROVIDER=smtp
MAIL_FROM="Nex-Gen Africa <connect@nex-gen.africa>"
MAIL_REPLY_TO=
SMTP_HOST=mail.nex-gen.africa
SMTP_PORT=465
SMTP_TLS=implicit
SMTP_USER=connect@nex-gen.africa
SMTP_PASS=<password of connect@nex-gen.africa>
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_API_URL=https://api.postmarkapp.com
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=
M365_LOGIN_URL=https://login.microsoftonline.com
M365_GRAPH_URL=https://graph.microsoft.com

# SMS and WhatsApp reminders (Twilio). WhatsApp stays off until Meta approves the templates.
MESSAGING_PROVIDER=twilio
TWILIO_ACCOUNT_SID=<AC...>
TWILIO_AUTH_TOKEN=<auth token>
TWILIO_SMS_FROM=<sending number or approved sender ID>
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SIDS={}
REMINDER_SEND_HOUR_LOCAL=9
